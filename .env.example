# Telegram
BOT_TOKEN=replace_with_bot_token
BOOTSTRAP_ADMIN_USERNAME=mohammadrezakheiry
# BOOTSTRAP_ADMIN_CHAT_ID=123456789
# HTTPS is required except for a loopback-only local Bot API test/server.
TELEGRAM_API_BASE=https://api.telegram.org

# Storage and runtime
DATA_DIR=./data
DATABASE_PATH=./data/alone_account.sqlite3
TIMEZONE=Asia/Tehran
CURRENCY_LABEL=تومان
POLL_TIMEOUT_SECONDS=30
REQUEST_TIMEOUT_SECONDS=45
JOB_INTERVAL_SECONDS=10
ORDER_EXPIRY_MINUTES=30
RECEIPT_DELAY_SECONDS=60
LOG_LEVEL=INFO

# Optional MacroDroid callback. Keep it blank to disable the HTTP listener.
# If set, use 43-128 URL-safe characters (generate with secrets.token_urlsafe(48)).
PAYMENT_CALLBACK_SECRET=
PAYMENT_CALLBACK_BIND=127.0.0.1
PAYMENT_CALLBACK_PORT=8787
PUBLIC_PAYMENT_CALLBACK_URL=

# Optional automatic crypto integration (disabled when blank).
PLISIO_API_KEY=
PLISIO_CURRENCY=USDT_TRX
# Prices are stored in toman, while Plisio accepts IRR (rial): 1 toman = 10 IRR.
PLISIO_SOURCE_CURRENCY=IRR
PLISIO_AMOUNT_MULTIPLIER=10

# colored (default): preserve the original green/blue/red styles.
# theme: optional fallback if a Telegram client displays unreadable colors.
BUTTON_COLOR_MODE=colored
# Set theme for Telegram-native, glass-like inline buttons. Telegram controls
# final transparency; there is no CSS/blur/opacity property in the Bot API.
# Optional public custom-emoji manifest; relative to this env file.
BUTTON_ICON_MANIFEST=

# Optional Telegram custom-emoji IDs. The bot owner needs Telegram Premium
# or the bot must have an eligible Fragment username. Button text stays emoji-free.
BUTTON_ICON_SHOP=
BUTTON_ICON_WALLET=
BUTTON_ICON_ACCOUNT=
BUTTON_ICON_SUPPORT=
BUTTON_ICON_REFERRAL=
BUTTON_ICON_CHANNEL=
BUTTON_ICON_BUY=
BUTTON_ICON_INFO=
BUTTON_ICON_BACK=
BUTTON_ICON_PAY=
BUTTON_ICON_DISCOUNT=
BUTTON_ICON_CARD=
BUTTON_ICON_CRYPTO=
BUTTON_ICON_COPY=
BUTTON_ICON_RECEIPT=
BUTTON_ICON_CANCEL=
BUTTON_ICON_ORDER=
BUTTON_ICON_UPLOAD=
BUTTON_ICON_PHONE=
